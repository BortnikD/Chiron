# Copy to .env.production on the server and fill in every empty value.
# Generate a separate JWT secret using the commands in .env.example.
JWT_SECRET=

# Initial admin account; use a unique password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=Admin

# PostgreSQL credentials; use a unique password.
POSTGRES_USER=chiron
POSTGRES_PASSWORD=
POSTGRES_DB=chiron

# Exact public frontend origin, including https://, without a path or trailing slash.
FRONTEND_ORIGIN=
