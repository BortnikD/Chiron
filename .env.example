# Generate a new one with any of these commands and paste the output as-is (single line):
#   Linux / macOS / Git Bash:
#     openssl rand -base64 64 | tr -d '\n'
#   PowerShell:
#     $b = [byte[]]::new(64); [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# Rotating the secret invalidates every previously issued token: all users will have to log in again.
JWT_SECRET=UR773DVLEHHOLplKX9r5+8Quur8pizAEqHgntpDBpGFnEMkQ1LwvYGJDefPO1DMn

# First admin account (created on startup if no user with this email exists)
# CHANGE THE PASSWORD. It is only used for the initial account creation, but the
# account keeps it until changed through the API.
ADMIN_EMAIL=admin@chiron.local
ADMIN_PASSWORD=admin123
ADMIN_PHONE=+70000000000
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=Admin

# PostgreSQL (used by both the `postgres` and the `backend` services)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=chiron

# Spring
# For IDE / direct Java runs, export these variables into the process environment.
# Choose `local` or `production`. The local Compose file always selects `local`.
# Loads `application-<profile>.yaml` on top of `application.yaml`.
SPRING_PROFILES_ACTIVE=local

# Photo storage; replace all example secrets for production.
# Use the externally reachable HTTPS address in production.
STORAGE_ENDPOINT=http://localhost:3900
STORAGE_PUBLIC_ENDPOINT=http://localhost:3900
STORAGE_REGION=garage
STORAGE_BUCKET=chiron-media
STORAGE_ACCESS_KEY=GK0123456789abcdef0123456789abcdef
STORAGE_SECRET_KEY=demo-only-storage-secret-not-for-production
# Generate 32 random bytes encoded as 64 hexadecimal characters.
GARAGE_RPC_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
